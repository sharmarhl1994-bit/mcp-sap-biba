# ── SAP Connection (required on the central server) ────────────────────────
SAP_URL=https://your-sap-server:44300
SAP_CLIENT=100
SAP_LANGUAGE=EN
# Uncomment for self-signed SAP certificates
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ── stdio mode only (not needed for HTTP mode) ──────────────────────────────
# SAP_USER=YOUR_USER
# SAP_PASSWORD=YOUR_PASSWORD

# ── HTTP server mode (npm run start:http) ───────────────────────────────────
# Port and bind address for the central MCP HTTP server
MCP_PORT=3000
MCP_HOST=0.0.0.0

